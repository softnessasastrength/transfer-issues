# Deployment upload exclusions. The repository itself is unaffected.
# data/ is regenerated by the deploy build (scripts/prepare_data.py);
# the local copy must not be uploaded (it is ~320 MB and Git-ignored).
data/
__pycache__/
# Internal working documents are repository records, not public web pages.
*.md
# The pre-UI prototype is an ancestor artifact, not part of the app.
prototype.html
